<div class="space-y-8">
  <h1 class="text-2xl font-bold text-zinc-900">Artists</h1>

  <div class="rounded-lg border border-zinc-200 bg-white p-6">
    <h2 class="mb-4 text-lg font-semibold text-zinc-800">Add Artist</h2>
    <.simple_form for={@form} phx-submit="create">
      <.input field={@form[:name]} label="Name" placeholder="Artist name" />
      <:actions>
        <.button type="submit">Add Artist</.button>
      </:actions>
    </.simple_form>
  </div>

  <div>
    <h2 class="mb-4 text-lg font-semibold text-zinc-800">All Artists</h2>
    <%= if @artists == [] do %>
      <p class="text-zinc-500">No artists yet.</p>
    <% else %>
      <.table id="artists" rows={@artists}>
        <:col :let={artist} label="Name">{artist.name}</:col>
      </.table>
    <% end %>
  </div>
</div>
