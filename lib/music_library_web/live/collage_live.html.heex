<div class="grid gap-0" style="grid-template-columns: repeat(auto-fill, 64px)">
  <%= for album <- @albums do %>
    <div class="w-16 h-16 overflow-hidden flex-shrink-0">
      <img
        src={album.file_path}
        alt={album.artist}
        title={"#{album.artist} — #{album.name}"}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>
  <% end %>
</div>

<%= if @albums == [] do %>
  <div class="flex items-center justify-center h-64 text-zinc-400">
    No local covers yet — the downloader is working in the background.
  </div>
<% end %>
