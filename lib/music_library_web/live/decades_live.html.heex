<div class="space-y-10">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold text-zinc-900">Decades</h1>
    <.link navigate="/" class="text-sm text-zinc-500 hover:text-zinc-800">← Dashboard</.link>
  </div>

  <%= if @decades == [] do %>
    <p class="text-sm text-zinc-400">No scrobble data found.</p>
  <% else %>
    <div class="space-y-14">
      <%= for decade <- @decades do %>
        <section id={"decade-#{decade.decade}"}>
          <div class="mb-5 flex items-baseline gap-4 border-b border-zinc-200 pb-3">
            <h2 class="text-2xl font-bold text-zinc-900">
              <%= decade.decade %>s
            </h2>
            <span class="text-sm text-zinc-400"><%= decade.count %> scrobbles</span>
          </div>

          <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
            <%!-- Top Artists --%>
            <div class="rounded-xl border border-zinc-200 bg-white shadow-sm">
              <div class="border-b border-zinc-100 px-5 py-3">
                <h3 class="text-sm font-semibold text-zinc-700">Top Artists</h3>
              </div>
              <ol class="divide-y divide-zinc-100">
                <%= for {a, i} <- Enum.with_index(decade.top_artists, 1) do %>
                  <li class="flex items-center gap-3 px-5 py-2.5">
                    <span class="w-4 text-right text-xs text-zinc-400"><%= i %></span>
                    <span class="flex-1 truncate text-sm text-zinc-800"><%= a.name %></span>
                    <span class="text-xs font-semibold text-zinc-400"><%= a.count %></span>
                  </li>
                <% end %>
              </ol>
            </div>

            <%!-- Top Albums --%>
            <div class="rounded-xl border border-zinc-200 bg-white shadow-sm">
              <div class="border-b border-zinc-100 px-5 py-3">
                <h3 class="text-sm font-semibold text-zinc-700">Top Albums</h3>
              </div>
              <ol class="divide-y divide-zinc-100">
                <%= for {al, i} <- Enum.with_index(decade.top_albums, 1) do %>
                  <li class="flex items-center gap-3 px-5 py-2.5">
                    <span class="w-4 text-right text-xs text-zinc-400"><%= i %></span>
                    <%= if al.cover_url && al.cover_url != "" do %>
                      <img src={al.cover_url} alt={al.name} class="h-7 w-7 flex-shrink-0 rounded object-cover" />
                    <% else %>
                      <div class="h-7 w-7 flex-shrink-0 rounded bg-zinc-100"></div>
                    <% end %>
                    <div class="flex-1 min-w-0">
                      <p class="truncate text-sm text-zinc-800"><%= al.name %></p>
                      <p class="truncate text-xs text-zinc-400"><%= al.artist %></p>
                    </div>
                    <span class="text-xs font-semibold text-zinc-400"><%= al.count %></span>
                  </li>
                <% end %>
              </ol>
            </div>

            <%!-- Top Tracks --%>
            <div class="rounded-xl border border-zinc-200 bg-white shadow-sm">
              <div class="border-b border-zinc-100 px-5 py-3">
                <h3 class="text-sm font-semibold text-zinc-700">Top Tracks</h3>
              </div>
              <ol class="divide-y divide-zinc-100">
                <%= for {t, i} <- Enum.with_index(decade.top_tracks, 1) do %>
                  <li class="flex items-center gap-3 px-5 py-2.5">
                    <span class="w-4 text-right text-xs text-zinc-400"><%= i %></span>
                    <div class="flex-1 min-w-0">
                      <p class="truncate text-sm text-zinc-800"><%= t.name %></p>
                      <p class="truncate text-xs text-zinc-400"><%= t.artist %></p>
                    </div>
                    <span class="text-xs font-semibold text-zinc-400"><%= t.count %></span>
                  </li>
                <% end %>
              </ol>
            </div>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
